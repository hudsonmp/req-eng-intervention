{
  "name": "promptlab-research-assistant",
  "version": "1.0.0",
  "description": "Embedded assistant for prompt programming research workflows",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
